# Hermetic — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon Postgres via Vercel) ---
DATABASE_URL=

# --- IPFS pinning (Pinata) ---
PINATA_JWT=
PINATA_GATEWAY=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Auth (magic link) ---
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- drand timelock network ---
# Default: quicknet (https://drand.cloudflare.com)
DRAND_NETWORK_URL=https://api.drand.sh

# --- Public app URL (for share links + magic-link redirects) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron protection (Vercel Cron sends this as Authorization header) ---
CRON_SECRET=
